{
  "name": "@lexair-geo/api",
  "version": "0.1.0",
  "private": true,
  "description": "LEXAIR GEO — API REST local (Fastify + PostgreSQL/PostGIS)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11 <27"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --coverage.enabled=false",
    "test:coverage": "vitest run --coverage",
    "test:integration": "LEXAIR_INTEGRATION=1 vitest run tests/integration",
    "migrate": "node dist/cli/migrate.js",
    "admin:create": "node dist/cli/create-admin.js",
    "seed:synthetic": "node dist/cli/seed-synthetic.js",
    "perf": "node dist/cli/load-test.js"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.9",
    "@fastify/rate-limit": "11.3.0",
    "@node-rs/argon2": "2.2.2",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
