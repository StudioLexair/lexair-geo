# LEXAIR GEO · /etc/lexair-geo/api.env (0640 root:lexair). EJEMPLO SIN SECRETOS.
# El instalador genera los valores reales; nunca versione el archivo real.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://lexair_api_login:CAMBIAR@127.0.0.1:5432/lexair_geo
DB_POOL_MAX=16
JWT_SECRET=GENERAR_CON_openssl_rand_-base64_48
TRUST_PROXY=127.0.0.1
MAP_MANIFEST_PATH=/srv/lexair-geo/maps/current/manifest.json
TILE_SERVICE_URL=http://127.0.0.1:8081
BACKUP_DIR=/srv/lexair-geo/backups
MIGRATIONS_DIR=/opt/lexair-geo/current/database/migrations
LOG_LEVEL=info
